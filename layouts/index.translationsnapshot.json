{{- $entries := dict -}}
{{- if os.FileExists ".build-i18n/manifest.json" -}}
  {{- $manifest := os.ReadFile ".build-i18n/manifest.json" | transform.Unmarshal -}}
  {{- range $manifest.items -}}
    {{- $id := .id -}}{{- $translated := dict -}}
    {{- range $field, $source := .fields -}}
      {{- $entry := index (index (hugo.Data.translations_en.entries | default dict) $id | default dict) $field -}}
      {{- if and $entry (eq $entry.hash $source.hash) -}}{{- $translated = merge $translated (dict $field $entry) -}}{{- end -}}
    {{- end -}}
    {{- if $translated -}}{{- $entries = merge $entries (dict $id $translated) -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- dict "version" 1 "revision" (hugo.Data.translations_en.revision | default "") "entries" $entries | jsonify -}}
